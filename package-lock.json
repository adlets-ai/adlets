{
  "name": "adlets-npm",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "adlets-npm",
      "workspaces": [
        "packages/adlets",
        "packages/indieads"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/adlets": {
      "resolved": "packages/adlets",
      "link": true
    },
    "node_modules/indieads": {
      "resolved": "packages/indieads",
      "link": true
    },
    "packages/adlets": {
      "version": "0.0.1",
      "license": "MIT",
      "bin": {
        "adlets": "bin/adlets.js"
      },
      "engines": {
        "node": ">=20"
      }
    },
    "packages/indieads": {
      "version": "0.0.1",
      "license": "MIT",
      "dependencies": {
        "adlets": "0.0.1"
      },
      "bin": {
        "indieads": "bin/indieads.js"
      },
      "engines": {
        "node": ">=20"
      }
    }
  }
}
